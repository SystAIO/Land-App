# SystIO Land — Backend environment (local only, never commit)
# Copy to .env and fill in real values.

# === Server ===
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081

# === Database (Supabase Postgres connection string — direct, not the API URL) ===
DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Optional CA cert for strict SSL verification in production
# DATABASE_CA=

# === JWT — used to sign app sessions ===
JWT_SECRET=CHANGE_ME_use_a_long_random_string_for_production

# === MSG91 (India OTP provider) ===
# Get these from your MSG91 dashboard: https://control.msg91.com
# Auth Key: Dashboard → Get Started
# Template ID: create an OTP template (requires DLT registration)
MSG91_AUTHKEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-dlt-approved-otp-template-id

# === Test OTP (temporary — disable before public release) ===
# When true, /auth/request-otp returns a fake requestId and /auth/verify-otp
# accepts TEST_OTP (default 123456) without calling MSG91.
TEST_OTP_ENABLED=false
TEST_OTP=123456

# === Razorpay (payments) ===
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-signing-secret

# === Admin login (seeded by backend/supabase/seed.sql) ===
# Change the seeded password immediately in production.
ADMIN_EMAIL=admin@systio.land
ADMIN_PASSWORD=Admin@123
