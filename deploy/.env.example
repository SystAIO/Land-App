# Land-App deployment configuration — copy to deploy.env and fill in.
# NEVER commit the filled-in file (deploy/.env* is gitignored).
# Usage: sudo bash scripts/setup-server.sh /path/to/deploy.env

# --- Server / app ---
APP_PORT=3000
LAND_DOMAIN=systio-land.duckdns.org
REPO_URL=https://github.com/SystAIO/Land-App.git

# --- Local PostgreSQL (role + database are created by setup-server.sh) ---
DB_NAME=land_app
DB_USER=landapp
# Leave empty to generate a random hex password.
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- App secrets ---
# Leave JWT_SECRET empty to generate a random 64-hex secret (min 32 chars in production).
JWT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional MSG91 OTP provider (required for real user sign-in) ---
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# --- Seeded admin account (password is (re)set every time setup runs) ---
ADMIN_EMAIL=admin@systio.land
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- DuckDNS (create the domain at https://www.duckdns.org first) ---
DUCKDNS_DOMAIN=systio-land.duckdns.org
DUCKDNS_TOKEN=REPLACE_WITH_DUCKDNS_TOKEN
