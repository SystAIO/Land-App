# Copy to .env.local and restart Expo.
#
# Set to false to use the deployed backend (default for EAS builds).
# true = on-device demo data (OTP 123456, simulated payments, demo admin).
EXPO_PUBLIC_DEMO_MODE=false

# --- Backend API (required when demo mode is false) ---
# Production backend: DuckDNS hostname → nginx → 127.0.0.1:3000 on the server
# Android emulator (AVD): http://10.0.2.2:3000
# Physical device on Wi-Fi: http://<your-LAN-ip>:3000
EXPO_PUBLIC_API_BASE_URL=http://estately.duckdns.org

# --- Google Maps (only needed for standalone APK/AAB; Expo Go has its own key) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-android-key

# Razorpay key id is returned by the backend (/listings/:id/submit), so it is
# not required in the app. The secret lives only on the backend.

# --- Cloudinary (property photos) ---
# Setup: https://console.cloudinary.com → Dashboard (cloud name) → Settings →
# Upload → Add upload preset → Signing mode: UNSIGNED → optional folder e.g. systio/properties
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
